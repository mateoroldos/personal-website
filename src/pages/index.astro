---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import ArrowUpRightIcon from "phosphor-svelte/lib/ArrowUpRightIcon";
import avatar from "../assets/avatar.png";
import avatarNight from "../assets/avatar-night.png";
import Layout from "../layouts/Layout.astro";

const nightAvatar = await getImage({ src: avatarNight, width: 48, densities: [1, 2, 3], format: "webp" });

const posts = (
	await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).map((post) => {
	const wordCount = post.body?.match(/\S+/g)?.length ?? 0;
	const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

	return { ...post, readingMinutes };
});

const projects = [
	{
		name: "md.uy",
		description: "Write Markdown together, browser to browser.",
		href: "https://md.uy/",
	},
	{
		name: "tokenbase",
		description: "Manage and export design tokens.",
		href: "https://token-base.com/",
	},
	{
		name: "gitboard",
		description: "Explore GitHub repos on a canvas.",
		href: "https://gitboard-app.netlify.app/",
	},
];
---

<Layout
	title="Mateo Roldos — Making software, carefully."
	description="I’m Mateo, a designer and developer. AI makes software abundant. I’m interested in what stays scarce: judgment, taste, and the enduring principles of design and engineering."
>
	<header class="space-y-12">
		<a href="/" class="inline-flex items-center gap-3 text-xl" aria-label="Mateo Roldos home">
			<picture class="size-12 shrink-0 overflow-hidden rounded-full border border-border bg-card">
				<source data-avatar-night media="(prefers-color-scheme: dark)" srcset={nightAvatar.srcSet.attribute} type="image/webp" />
				<Image
					src={avatar}
					alt=""
					class="size-full object-cover"
					width={48}
					height={48}
					densities={[1, 2, 3]}
					loading="eager"
				/>
			</picture>
			<span>Mateo Roldos</span>
		</a>

		<div class="space-y-3">
			<h1 class="text-3xl font-normal leading-tight tracking-tight text-foreground sm:text-4xl">
				Making software, carefully.
			</h1>
			<p class="text-lg leading-relaxed">
				I’m Mateo, a designer and developer. AI makes software abundant. I’m interested in what stays scarce: judgment, taste, and the enduring principles of design and engineering.
			</p>
			<p class="text-lg leading-relaxed">
				Currently building <strong class="font-medium">Moku.</strong>
			</p>
		</div>
	</header>

	<section class="mt-16 space-y-4 sm:mt-20" aria-labelledby="writing-heading">
		<h2 id="writing-heading" class="text-2xl font-medium leading-tight tracking-tight">Writing</h2>

		<ul>
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`} class="group block py-4">
						<span class="block space-y-1.5">
							<span class="block text-xl font-medium leading-snug text-foreground underline decoration-border underline-offset-4 group-hover:decoration-current">
								{post.data.title}
							</span>
							<span class="flex flex-wrap items-center gap-x-2 text-sm text-muted-foreground">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString("en", {
										month: "long",
										year: "numeric",
										timeZone: "UTC",
									})}
								</time>
								<span aria-hidden="true">·</span>
								<span>~{post.readingMinutes} min read</span>
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="mt-16 space-y-4 sm:mt-20" aria-labelledby="projects-heading">
		<h2 id="projects-heading" class="text-2xl font-medium leading-tight tracking-tight">Software</h2>

		<ul class="divide-y divide-border rounded-lg border border-border">
			{projects.map((project) => (
				<li>
					<a href={project.href} class="group flex items-center gap-4 rounded-lg px-4 py-4 hover:bg-card" target="_blank" rel="noreferrer">
						<span class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
							<span class="text-lg font-medium leading-snug text-foreground underline decoration-border underline-offset-4 group-hover:decoration-current sm:w-24 sm:shrink-0">
								{project.name}
							</span>
							<span class="text-sm leading-relaxed text-muted-foreground">{project.description}</span>
						</span>
						<ArrowUpRightIcon size="1em" weight="regular" class="shrink-0 text-muted-foreground group-hover:text-foreground" aria-hidden="true" />
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="mt-16 space-y-4 sm:mt-20" aria-labelledby="behind-heading">
		<h2 id="behind-heading" class="text-2xl font-medium leading-tight tracking-tight">Behind the work</h2>
		<div class="space-y-3 text-lg leading-relaxed">
			<p>I’m a software developer in Montevideo, Uruguay, with a background in industrial design.</p>
			<p>
				My <a class="underline underline-offset-4" href="https://github.com/mateoroldos/agents" target="_blank" rel="noreferrer">agent setup</a>{" "}
				and <a class="underline underline-offset-4" href="https://github.com/mateoroldos/dotfiles" target="_blank" rel="noreferrer">dotfiles</a> are public too.
			</p>
			<p>Have a question or a different take? <a class="underline underline-offset-4" href="mailto:mateoroldos19@gmail.com">Write to me.</a></p>
		</div>
	</section>
</Layout>
