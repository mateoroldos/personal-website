---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = (
	await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const projects = [
	{
		name: "md.uy",
		description: "A minimal peer-to-peer Markdown editor that syncs using WebRTC.",
		href: "https://md.uy/",
	},
	{
		name: "tokenbase",
		description: "A design token manager for turning visual decisions into exportable code.",
		href: "https://token-base.com/",
	},
	{
		name: "gitboard",
    description: "An interactive canvas for making GitHub repos feel less static.",
		href: "https://gitboard-app.netlify.app/",
	},
];

const workspace = [
	{
		name: "dotfiles",
		description: "My terminal, nvim, and machine setup.",
		href: "https://github.com/mateoroldos/dotfiles",
	},
	{
		name: "agents",
		description: "Personal collection of prompts and skills.",
		href: "https://github.com/mateoroldos/agents",
	},
];

const experience = [
	{
		name: "Independent work",
		years: "2026-now",
		description: "Taking time to dive deep into Effect.ts and AI while building tools for agents, visual tutorials, and Discord communities.",
	},
	{
		name: "Numinous Labs",
		years: "2025-2026",
		description: "Designed and built AI tools for prediction markets and decision workflows.",
		href: "https://numinouslabs.io/",
	},
	{
		name: "Flipzen",
		years: "2024",
		description: "Built product surfaces for AI-assisted compliance work.",
		href: "https://flipzen.com/",
	},
	{
		name: "Emerald Labs",
		years: "2022-2024",
		description: "Joined my main client full time to build education and tooling around Flow Blockchain.",
		href: "https://academy.ecdao.org/",
	},
	{
		name: "Independent developer",
		years: "2019-2022",
		description: "Started studying web development and freelancing for local companies.",
	},
];
---

<Layout>
	<header class="space-y-6">
		<a
			href="/"
			class="inline-flex size-14 overflow-hidden rounded-full border border-border bg-card"
			aria-label="mateoroldos home"
		>
			<img
				src="/mateoroldos.jpg"
				alt="mateoroldos"
				class="size-full object-cover"
				width="60"
				height="60"
			/>
		</a>

		<div class="space-y-3">
			<h1 class="text-4xl font-normal leading-tight tracking-tight text-foreground sm:text-5xl">
				Mateo Roldos
			</h1>
      <p class="max-w-xl text-xl leading-relaxed text-muted-foreground">
        Software developer from Montevideo, Uruguay.
      </p>
			<p class="max-w-xl text-xl leading-relaxed text-foreground">
        Self-taught developer with a background in industrial design. I build for the web with a sharp eye for product and design. When I'm not coding, I'm playing football.
			</p>
		</div>
	</header>

	<section class="mt-14 space-y-4" aria-labelledby="blog-heading">
		<h2 id="blog-heading" class="text-3xl font-medium leading-tight tracking-tight">Blog</h2>

		<ul>
			{posts.map((post) => (
				<li>
				<a href={`/blog/${post.id}/`} class="group block py-4">
					<span class="block space-y-1.5">
						<span class="block text-2xl font-medium leading-snug text-foreground underline decoration-border underline-offset-4 group-hover:decoration-current">
							{post.data.title}
						</span>
						<span class="block text-lg leading-relaxed text-muted-foreground">{post.data.description}</span>
						<time datetime={post.data.pubDate.toISOString()} class="block text-sm text-muted-foreground">
							{post.data.pubDate.toLocaleDateString("en", {
								month: "short",
								day: "2-digit",
								year: "numeric",
							})}
						</time>
					</span>
				</a>
				</li>
			))}
		</ul>
	</section>

	<section class="mt-14 space-y-4" aria-labelledby="projects-heading">
		<div class="space-y-1">
			<h2 id="projects-heading" class="text-3xl font-medium leading-tight tracking-tight">Open Source</h2>
			<p class="text-lg leading-relaxed text-muted-foreground">
				Some open source projects I feel proud of.
			</p>
		</div>

		<ul>
			{projects.map((project) => (
				<li>
					<a
						href={project.href}
						class="group block py-4"
						target="_blank"
						rel="noreferrer"
					>
						<span class="block space-y-1.5">
							<span class="block text-2xl font-medium leading-snug text-foreground underline decoration-border underline-offset-4 group-hover:decoration-current">
								{project.name}
							</span>
							<span class="block text-lg leading-relaxed text-muted-foreground">{project.description}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="mt-14 space-y-4" aria-labelledby="experience-heading">
		<h2 id="experience-heading" class="text-3xl font-medium leading-tight tracking-tight">Experience</h2>

		<ul>
			{experience.map((item) => (
				<li>
					<a
						href={item.href ?? undefined}
						class:list={["block py-4", item.href && "group"]}
						target={item.href ? "_blank" : undefined}
						rel={item.href ? "noreferrer" : undefined}
					>
						<span class="block space-y-1.5">
							<span
								class:list={[
									"block text-2xl font-medium leading-snug text-foreground",
									item.href && "underline decoration-border underline-offset-4 group-hover:decoration-current",
								]}
							>
								{item.name}
							</span>
							<span class="block text-sm text-muted-foreground">
								{item.years}
							</span>
							<span class="block text-lg leading-relaxed text-muted-foreground">{item.description}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="mt-14 space-y-4" aria-labelledby="workspace-heading">
		<div class="space-y-1">
			<h2 id="workspace-heading" class="text-3xl font-medium leading-tight tracking-tight">Workspace</h2>
			<p class="text-lg leading-relaxed text-muted-foreground">
				Personal config, habits, and small systems I keep refining.
			</p>
		</div>

		<ul>
			{workspace.map((item) => (
				<li>
					<a
						href={item.href}
						class="group block py-4"
						target="_blank"
						rel="noreferrer"
					>
						<span class="block space-y-1.5">
							<span class="block text-2xl font-medium leading-snug text-foreground underline decoration-border underline-offset-4 group-hover:decoration-current">
								{item.name}
							</span>
							<span class="block text-lg leading-relaxed text-muted-foreground">{item.description}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</Layout>
