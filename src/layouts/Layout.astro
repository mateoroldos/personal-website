---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title = "mateoroldos", description = "Personal website of mateoroldos, software designer and builder." } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" data-light="/favicon-32x32.png" data-dark="/favicon-night-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" data-light="/favicon-16x16.png" data-dark="/favicon-night-16x16.png" />
		<link rel="icon" href="/favicon.ico" data-light="/favicon.ico" data-dark="/favicon-night.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" data-light="/apple-touch-icon.png" data-dark="/apple-touch-icon-night.png" />
		<script is:inline>
			(() => {
				const parseTheme = (value) => value === "light" || value === "dark" ? value : "system";
				let theme = "system";
				const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

				try {
					theme = parseTheme(localStorage.getItem("theme"));
				} catch {
					// Keep the system preference when storage is unavailable.
				}

				const applyTheme = () => {
					const dark = theme === "dark" || (theme === "system" && systemTheme.matches);
					document.documentElement.dataset.theme = theme;

					document.querySelectorAll("link[data-light][data-dark]").forEach((link) => {
						link.href = dark ? link.dataset.dark : link.dataset.light;
					});
					document.querySelectorAll("source[data-avatar-night]").forEach((source) => {
						source.media = dark ? "all" : "not all";
					});

					document.querySelectorAll('input[name="theme"]').forEach((input) => {
						input.checked = input.value === theme;
					});
				};

				applyTheme();
				document.addEventListener("DOMContentLoaded", applyTheme);
				document.addEventListener("astro:after-swap", applyTheme);
				systemTheme.addEventListener("change", applyTheme);
				document.addEventListener("change", (event) => {
					if (!(event.target instanceof HTMLInputElement) || event.target.name !== "theme") return;

					theme = parseTheme(event.target.value);
					applyTheme();

					try {
						localStorage.setItem("theme", theme);
					} catch {
						// The selection still works for this visit without persistence.
					}
				});
			})();
		</script>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="min-h-svh bg-background text-foreground antialiased">
		<main class="mx-auto flex min-h-svh w-full max-w-2xl flex-col px-6 py-10 sm:py-16">
			<slot />
			<Footer />
		</main>
	</body>
</html>

<style is:global>
	@keyframes subtleFadeIn {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes subtleFadeOut {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(3px);
		}
	}

	::view-transition-old(root) {
		animation: subtleFadeOut 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
	}

	::view-transition-new(root) {
		animation: subtleFadeIn 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-old(root),
		::view-transition-new(root) {
			animation: none;
		}
	}
</style>
